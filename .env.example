# Copy this file to .env and fill it in.

# Discord Developer Portal > your application > OAuth2 > Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where the server listens. Keep 127.0.0.1 and put a reverse proxy (HTTPS) in front:
# Discord only loads an Activity from an https address.
HOST=127.0.0.1
PORT=3090

# Optional: paths to yt-dlp / ffmpeg if they are not on PATH
YTDLP=
FFMPEG=
# Optional: a cookies.txt (Netscape format) with your bilibili / niconico login.
# bilibili currently needs it (plus YTDLP_ARGS=--impersonate chrome) for videos to load.
YTDLP_COOKIES=
# Optional: extra yt-dlp arguments, separated by spaces
YTDLP_ARGS=--impersonate chrome

# Prepared videos and live streams (HLS segments). Old ones are removed automatically.
CACHE_DIR=./cache
CACHE_MAX_GB=5
# Highest video quality to fetch (720 / 1080 …)
MAX_HEIGHT=1080
# Longest list per room
MAX_QUEUE=50
# Most videos taken from one playlist link
MAX_PLAYLIST=200

# Optional: only these Discord servers may use it (server IDs, separated by commas).
# Empty = any server the app is used in.
ALLOWED_GUILDS=
